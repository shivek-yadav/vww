# ==============================================================
# VIJAY WOOLLEN WORKS (VWW) - PRODUCTION ENVIRONMENT TEMPLATE
# ==============================================================

# Server Environment & Port
NODE_ENV=production
PORT=5000

# MongoDB Connection String (Atlas URI or dedicated replica set)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vww_production?retryWrites=true&w=majority

# JWT Secret Key (Must be at least 32 characters, recommended 64-char random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_random_hex

# Allowed Frontend URL(s) for CORS and Password Reset Links
# Multiple origins can be separated by commas (e.g. https://example.com,https://www.example.com)
CLIENT_URL=https://your-production-domain.com

# Initial Super Admin Credentials (Created only once if no admin exists)
ADMIN_EMAIL=shivekyadav82@gmail.com
ADMIN_PASSWORD=SetAStrongPasswordHere123!

# ImageKit Configuration (For direct image uploads and CDN delivery)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint_id

# SMTP Mail Server (Optional: for automated password reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM="Vijay Woollen Works <noreply@your-domain.com>"
